# OMNI Configuration
# Rename this file to .env and fill in the values

# Core
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://user:pass@host:port/dbname

# AI Models (via Kie.ai or OpenRouter)
KIE_API_KEY=
OPENROUTER_API_KEY=

# Social Media Posting (Blotato)
BLOTATO_API_KEY=

# GitHub Updates (for self-updating features)
GITHUB_TOKEN=
GITHUB_OWNER=dannyyycodes
GITHUB_REPO=Omni-Agent
