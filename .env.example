# ============================================================
# OMNI AI Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================
# AI Model APIs
# ============================================================

# OpenRouter API (for Claude, GPT, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Video Generation
# ============================================================

# Kie.ai API (for Sora 2 video generation)
# Get your key at: https://kie.ai
KIE_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Social Media Posting
# ============================================================

# Blotato API (for multi-platform posting)
# Get your key at: https://blotato.com
BLOTATO_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Database
# ============================================================

# Railway will automatically set DATABASE_URL
# For local development, use SQLite:
DATABASE_URL=sqlite:///omni.db

# For production PostgreSQL (Railway format):
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================
# Application Settings
# ============================================================

# Flask secret key (generate with: python -c "import os; print(os.urandom(24).hex())")
SECRET_KEY=your-secret-key-here

# Video output directory (Railway uses /tmp)
VIDEO_OUTPUT_DIR=/tmp/omni_videos

# ============================================================
# GitHub Integration (for self-update feature)
# ============================================================

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=omni-ai-agent

# ============================================================
# Monitoring & Logging (Optional)
# ============================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================
# Email Alerts (Optional)
# ============================================================

# SMTP settings for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=your-email@gmail.com
